# URL ของเว็บ (บน Render ให้ใส่ https://ชื่อแอป.onrender.com)
BASE_URL=http://localhost:8000

# สุ่มข้อความยาวๆ เช่น: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
CRON_SECRET=change-me-too

# ว่างไว้ = ใช้ SQLite ในเครื่อง / บน Render ใส่ connection string ของ Neon หรือ Supabase
DATABASE_URL=

# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API channel (Official Account) — Channel access token (long-lived)
LINE_MESSAGING_TOKEN=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 1 = เปิดปุ่มเข้าระบบแบบทดสอบโดยไม่ใช้ LINE (ใช้เฉพาะในเครื่อง ห้ามเปิดบน Render)
DEV_LOGIN=0
